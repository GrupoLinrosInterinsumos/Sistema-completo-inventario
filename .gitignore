# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sqlite dev database
*.db
*.db-journal

# herramientas/config locales de asistentes de IA (no son parte de la app)
/.claude/
/.agents/
/.windsurf/
/skills-lock.json

# carpeta ajena a este proyecto (archivos personales/de trabajo del usuario)
/Descargas/

# copia original del logo subida al inicio (se usa public/logo-gli.jpg)
/logo gli.jpeg
